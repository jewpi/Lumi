<?xml version="1.0"?>
<package format="3">
  <name>lumi_slam_bringup</name>
  <version>0.1.0</version>
  <description>One-command YDLIDAR X4 Pro and lidar-only SLAM bringup.</description>
  <maintainer email="lumi@example.com">Lumi Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>cartographer_ros</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
