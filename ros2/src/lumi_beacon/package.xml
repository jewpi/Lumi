<?xml version="1.0"?>
<package format="3">
  <name>lumi_beacon</name>
  <version>0.1.0</version>
  <description>BLE beacon arrival detector for the Lumi robot.</description>
  <maintainer email="lumi@example.com">Lumi Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-bleak</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
