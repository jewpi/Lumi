<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lumi_perception</name>
  <version>0.1.0</version>
  <description>
    Lumi 안내 로봇 인지 브리지 — edge-ai-agent가 UDP로 송출하는
    카메라 프레임(JPEG)과 YOLO 탐지 결과(JSON)를 ROS2 토픽으로 발행한다.
  </description>
  <maintainer email="maintainer@example.com">LSH</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
