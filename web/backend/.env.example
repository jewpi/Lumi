# 백엔드 인증 환경변수 템플릿 — 복사해서 같은 폴더에 .env(비커밋, gitignore됨)로 저장
#   cp web/backend/.env.example web/backend/.env
#
# 이 한 파일을 두 곳이 공유한다:
#   - 로컬 개발:      uvicorn app.main:app --env-file .env  (web/backend에서)
#   - docker compose: backend 서비스의 env_file (docker-compose.yml)
# EC2 배포 시에도 서버의 web/backend/.env에 같은 형식으로 둔다.
# GitLab CI에 배포 잡을 붙일 땐 CI/CD Variables(masked+protected)로 관리하고 YAML에 넣지 않는다.

# JWT 서명 키 (필수 — 없으면 백엔드가 부팅을 거부한다)
# 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 최초 부팅 시 관리자 계정 시드 (admins 테이블이 비어 있을 때만 사용, 12자 이상)
# 이후 이 값을 바꿔도 이미 만들어진 계정의 비밀번호는 바뀌지 않는다 —
# 비밀번호를 바꾸려면 관리자 페이지(/admins)를 쓰거나 admins 테이블을 비우고 재기동.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 토큰 만료(분) — 기본 480(8시간)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 카메라 WebSocket JPEG 프레임 한 장의 최대 크기(bytes). Jetson 인그레스는 별도 키 없이
# EC2 네트워크 계층에서 보호하며, 애플리케이션은 크기·JPEG 형식을 검증한다.
CAMERA_MAX_FRAME_BYTES=300000

# 측위 방식 — slam(POST /api/pose 기준, 기본) | beacon(POST /api/beacon-scan의 최근접 존)
# 세션 mode(ASSIST/GUIDE)와는 무관하다.
POSITIONING_MODE=slam
